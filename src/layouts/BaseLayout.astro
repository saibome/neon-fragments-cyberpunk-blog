---
import '../styles/global.css';
import 'highlight.js/styles/atom-one-dark.css';
import Navbar from '../components/Navbar.astro';
import ProfileSidebar from '../components/ProfileSidebar.astro';
import { DEFAULT_AUTHOR } from '../../config';
import { absoluteUrl } from '../../lib/permalink';
import { SITE_URL } from '../lib/site';

interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
  activePath?: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  articleTags?: string[];
  publishedTime?: string;
  noindex?: boolean;
}

const {
  title,
  description,
  canonicalPath = '/',
  activePath = '/',
  ogImage,
  ogType = 'website',
  articleTags = [],
  publishedTime,
  noindex = false
} = Astro.props;

const canonicalUrl = absoluteUrl(SITE_URL, canonicalPath);
const profile = DEFAULT_AUTHOR;
---

<!DOCTYPE html>
<html lang="zh-CN" style="background-color: #050505">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#050505" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" type="image/svg+xml" href="/avatar.svg" />
    <link rel="preload" href="/fonts/rajdhani-700.ttf" as="font" type="font/ttf" crossorigin />
    <link rel="preload" href="/fonts/share-tech-mono-400.ttf" as="font" type="font/ttf" crossorigin />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" type="application/rss+xml" title="霓虹碎片 RSS" href={`${SITE_URL}/rss.xml`} />
    {noindex && <meta name="robots" content="noindex,follow" />}

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="霓虹碎片" />
    <meta property="og:locale" content="zh_CN" />
    {ogImage && <meta property="og:image" content={ogImage} />}
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {articleTags.map(tag => <meta property="article:tag" content={tag} />)}
    {ogImage && <meta name="twitter:card" content="summary_large_image" />}
    {ogImage && <meta name="twitter:title" content={title} />}
    {ogImage && <meta name="twitter:description" content={description} />}
    {ogImage && <meta name="twitter:image" content={ogImage} />}
  </head>
  <body class="font-display antialiased bg-scanlines min-h-screen bg-fixed">
    <div class="min-h-screen flex flex-col font-sans text-gray-100 selection:bg-cyber-yellow selection:text-black">
      <Navbar activePath={activePath}>
        <Fragment slot="sidebar">
          <ProfileSidebar user={profile} activePath={activePath} />
        </Fragment>
      </Navbar>

      <main class="flex-grow container mx-auto max-w-7xl w-full px-0 sm:px-6 lg:px-8 py-2 md:py-6 mt-16">
        <div class="flex flex-col lg:flex-row gap-6 items-start">
          <aside data-mobile-sidebar class="fixed inset-0 z-40 bg-black pt-24 px-6 pb-6 overflow-y-auto transition-transform duration-300 ease-in-out lg:hidden">
            <ProfileSidebar user={profile} activePath={activePath} />
          </aside>

          <div class="hidden lg:block w-80 flex-shrink-0"></div>

          <div data-sidebar-backdrop class="fixed inset-0 bg-black/50 z-30 lg:hidden backdrop-blur-sm"></div>

          <section class="flex-grow min-w-0">
            <slot />
          </section>
        </div>
      </main>

      <footer class="border-t border-gray-800 bg-black py-8 mt-12">
        <div class="max-w-7xl mx-auto px-4 text-center">
          <p class="text-gray-600 font-mono text-xs">© 2077 SAIBO.ME // 保留所有权利</p>
          <div class="mt-2 text-[10px] text-gray-700 uppercase tracking-[0.2em]">
            <a href="https://beian.miit.gov.cn/" target="_blank" rel="nofollow noopener noreferrer" class="hover:text-gray-500 transition-colors">粤ICP备2026121562号-2</a>
            {' '}// 安全连接
          </div>
        </div>
      </footer>
    </div>

    <script>
      import '../scripts/site.js';
    </script>
  </body>
</html>
