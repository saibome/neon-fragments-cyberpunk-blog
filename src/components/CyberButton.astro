---
interface Props {
  variant?: 'primary' | 'secondary' | 'danger';
  class?: string;
  id?: string;
  type?: 'button' | 'submit' | 'reset';
  disabled?: boolean;
  'aria-label'?: string;
  'data-share-open'?: string;
}

const { variant = 'primary', class: className = '', ...rest } = Astro.props;

const variants = {
  primary: 'bg-cyber-yellow text-cyber-black hover:bg-white border-2 border-transparent',
  secondary: 'bg-transparent text-cyber-cyan border-2 border-cyber-cyan hover:bg-cyber-cyan/10',
  danger: 'bg-cyber-red text-white hover:bg-red-600'
};
---

<button
  {...rest}
  class:list={[
    'relative px-6 py-3 font-bold font-mono uppercase tracking-widest text-sm transition-all duration-200 clip-corner focus:outline-none glitch-hover',
    variants[variant],
    className
  ]}
>
  <span aria-hidden="true" class="absolute top-0 right-0 w-2 h-2 bg-current opacity-50"></span>
  <span aria-hidden="true" class="absolute bottom-0 left-0 w-2 h-2 bg-current opacity-50"></span>
  <slot />
</button>
