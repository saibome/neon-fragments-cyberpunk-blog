---
import Icon from './Icon.astro';

interface Props {
  title: string;
  url: string;
}

const { title, url } = Astro.props;
---

<dialog
  data-share-dialog
  aria-labelledby="share-dialog-title"
  class="bg-cyber-dark border-2 border-cyber-cyan clip-corner p-1 shadow-[0_0_20px_rgba(0,255,255,0.3)] text-gray-100"
>
  <div class="flex items-center justify-between bg-cyber-cyan/10 p-4 border-b border-cyber-cyan/30">
    <h3 id="share-dialog-title" class="text-xl font-display font-bold text-cyber-cyan tracking-wider">分享数据</h3>
    <button type="button" data-share-close aria-label="关闭分享弹窗" title="关闭" class="text-cyber-cyan hover:text-white transition-colors">
      <Icon name="x" class="w-6 h-6" />
    </button>
  </div>

  <div class="p-6 space-y-3">
    <button type="button" data-copy={url} class="w-full flex items-center justify-between p-3 border border-gray-700 bg-gray-900/50 hover:border-cyber-yellow/50 hover:bg-cyber-yellow/5 transition-all group">
      <span class="flex items-center space-x-3">
        <Icon name="link" class="w-4 h-4 text-gray-400 group-hover:text-cyber-yellow" />
        <span class="font-mono text-sm text-gray-300 group-hover:text-white">仅复制链接</span>
      </span>
      <span class="flex items-center space-x-1 text-sm font-mono text-gray-500 group-hover:text-cyber-yellow">
        <span data-copy-label>复制</span>
        <Icon name="copy" class="w-4 h-4" />
      </span>
    </button>

    <button type="button" data-copy={`${title} - ${url}`} class="w-full flex items-center justify-between p-3 border border-gray-700 bg-gray-900/50 hover:border-cyber-yellow/50 hover:bg-cyber-yellow/5 transition-all group">
      <span class="flex items-center space-x-3">
        <Icon name="link" class="w-4 h-4 text-gray-400 group-hover:text-cyber-yellow" />
        <span class="font-mono text-sm text-gray-300 group-hover:text-white">复制标题和链接</span>
      </span>
      <span class="flex items-center space-x-1 text-sm font-mono text-gray-500 group-hover:text-cyber-yellow">
        <span data-copy-label>复制</span>
        <Icon name="copy" class="w-4 h-4" />
      </span>
    </button>
  </div>

  <div aria-hidden="true" class="absolute top-0 left-0 w-4 h-4 border-t-2 border-l-2 border-cyber-cyan"></div>
  <div aria-hidden="true" class="absolute top-0 right-0 w-4 h-4 border-t-2 border-r-2 border-cyber-cyan"></div>
  <div aria-hidden="true" class="absolute bottom-0 left-0 w-4 h-4 border-b-2 border-l-2 border-cyber-cyan"></div>
  <div aria-hidden="true" class="absolute bottom-0 right-0 w-4 h-4 border-b-2 border-r-2 border-cyber-cyan"></div>
</dialog>

<script>
  import '../scripts/share-dialog.js';
</script>
