---
import Icon from './Icon.astro';

interface Props {
  title: string;
  url: string;
}

const { title, url } = Astro.props;

const icons: Record<string, string> = {
  x: '<path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z" />',
  linkedin: '<path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z" />',
  reddit: '<path d="M12 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0zm5.01 4.744c.688 0 1.25.561 1.25 1.249a1.25 1.25 0 0 1-2.498.056l-2.597-.547-.8 3.747c1.824.07 3.48.632 4.674 1.488.308-.309.73-.491 1.207-.491.968 0 1.754.786 1.754 1.754 0 .716-.435 1.333-1.01 1.614a3.111 3.111 0 0 1 .042.52c0 2.694-3.13 4.87-7.004 4.87-3.874 0-7.004-2.176-7.004-4.87 0-.183.015-.366.043-.534A1.748 1.748 0 0 1 4.028 12c0-.968.786-1.754 1.754-1.754.463 0 .898.196 1.207.49 1.207-.883 2.878-1.43 4.744-1.487l.885-4.182a.342.342 0 0 1 .14-.197.35.35 0 0 1 .238-.042l2.906.617a1.214 1.214 0 0 1 1.108-.701zM9.25 12C8.561 12 8 12.562 8 13.25c0 .687.561 1.248 1.25 1.248.687 0 1.248-.561 1.248-1.249 0-.688-.561-1.249-1.249-1.249zm5.5 0c-.687 0-1.248.561-1.248 1.25 0 .687.561 1.248 1.249 1.248.688 0 1.249-.561 1.249-1.249 0-.687-.562-1.249-1.25-1.249zm-5.466 3.99a.327.327 0 0 0-.231.094.33.33 0 0 0 0 .463c.842.842 2.484.913 2.961.913.477 0 2.105-.056 2.961-.913a.361.361 0 0 0 .029-.463.33.33 0 0 0-.464 0c-.547.533-1.684.73-2.512.73-.828 0-1.979-.196-2.512-.73a.326.326 0 0 0-.232-.095z" />',
  facebook: '<path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z" />',
  truth: '<path d="M4 4h16v4h-6v12h-4V8H4z" />',
  tumblr: '<path d="M14.563 24c-5.093 0-7.031-3.756-7.031-6.411V9.747H5.116V6.648c3.63-1.313 4.512-4.596 4.71-6.469C9.84.051 9.941 0 9.999 0h3.517v6.114h4.801v3.633h-4.82v7.47c.016 1.001.375 2.371 2.207 2.371h.09c.631-.02 1.486-.205 1.936-.419l1.156 3.425c-.436.636-2.4 1.374-4.156 1.404h-.178l.011.002z" />'
};

const shareLinks = [
  { name: 'X', icon: 'x', url: `https://twitter.com/intent/tweet?text=${encodeURIComponent(title)}&url=${encodeURIComponent(url)}`, color: 'hover:text-white' },
  { name: 'LinkedIn', icon: 'linkedin', url: `https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(url)}`, color: 'hover:text-[#0077b5]' },
  { name: 'Reddit', icon: 'reddit', url: `https://www.reddit.com/submit?url=${encodeURIComponent(url)}&title=${encodeURIComponent(title)}`, color: 'hover:text-[#ff4500]' },
  { name: 'Facebook', icon: 'facebook', url: `https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(url)}`, color: 'hover:text-[#1877f2]' },
  { name: 'Truth Social', icon: 'truth', url: `https://truthsocial.com/share?text=${encodeURIComponent(`${title} ${url}`)}`, color: 'hover:text-[#6c37e0]' },
  { name: 'Tumblr', icon: 'tumblr', url: `https://www.tumblr.com/widgets/share/tool?canonicalUrl=${encodeURIComponent(url)}&title=${encodeURIComponent(title)}`, color: 'hover:text-[#36465d]' }
];
---

<dialog
  data-share-dialog
  aria-labelledby="share-dialog-title"
  class="relative w-full max-w-md bg-cyber-dark border-2 border-cyber-cyan clip-corner p-1 shadow-[0_0_20px_rgba(0,255,255,0.3)] text-gray-100"
>
  <div class="flex items-center justify-between bg-cyber-cyan/10 p-4 border-b border-cyber-cyan/30">
    <h3 id="share-dialog-title" class="text-xl font-display font-bold text-cyber-cyan tracking-wider">分享数据</h3>
    <button type="button" data-share-close aria-label="关闭分享弹窗" title="关闭" class="text-cyber-cyan hover:text-white transition-colors">
      <Icon name="x" class="w-6 h-6" />
    </button>
  </div>

  <div class="p-6 space-y-6">
    <div class="grid grid-cols-3 gap-4">
      {shareLinks.map(link => (
        <a
          href={link.url}
          target="_blank"
          rel="noopener noreferrer"
          class:list={[
            'flex flex-col items-center justify-center p-4 border border-gray-700 bg-gray-900/50 hover:border-cyber-cyan/50 hover:bg-cyber-cyan/5 transition-all group',
            link.color
          ]}
        >
          <div class="mb-2 transition-transform group-hover:scale-110 group-hover:drop-shadow-[0_0_5px_currentColor]">
            <svg viewBox="0 0 24 24" fill="currentColor" class="w-6 h-6" aria-hidden="true" set:html={icons[link.icon]} />
          </div>
          <span class="text-xs font-mono text-gray-400 group-hover:text-white">{link.name}</span>
        </a>
      ))}
    </div>

    <div class="space-y-3">
      <button type="button" data-copy={url} class="w-full flex items-center justify-between p-3 border border-gray-700 bg-gray-900/50 hover:border-cyber-yellow/50 hover:bg-cyber-yellow/5 transition-all group">
        <span class="flex items-center space-x-3">
          <Icon name="link" class="w-4 h-4 text-gray-400 group-hover:text-cyber-yellow" />
          <span class="font-mono text-sm text-gray-300 group-hover:text-white">仅复制链接</span>
        </span>
        <span class="flex items-center space-x-1 text-sm font-mono text-gray-500 group-hover:text-cyber-yellow">
          <span data-copy-label>复制</span>
          <Icon name="copy" class="w-4 h-4" />
        </span>
      </button>

      <button type="button" data-copy={`${title} - ${url}`} class="w-full flex items-center justify-between p-3 border border-gray-700 bg-gray-900/50 hover:border-cyber-yellow/50 hover:bg-cyber-yellow/5 transition-all group">
        <span class="flex items-center space-x-3">
          <Icon name="link" class="w-4 h-4 text-gray-400 group-hover:text-cyber-yellow" />
          <span class="font-mono text-sm text-gray-300 group-hover:text-white">复制标题和链接</span>
        </span>
        <span class="flex items-center space-x-1 text-sm font-mono text-gray-500 group-hover:text-cyber-yellow">
          <span data-copy-label>复制</span>
          <Icon name="copy" class="w-4 h-4" />
        </span>
      </button>
    </div>
  </div>

  <div aria-hidden="true" class="absolute top-0 left-0 w-4 h-4 border-t-2 border-l-2 border-cyber-cyan"></div>
  <div aria-hidden="true" class="absolute top-0 right-0 w-4 h-4 border-t-2 border-r-2 border-cyber-cyan"></div>
  <div aria-hidden="true" class="absolute bottom-0 left-0 w-4 h-4 border-b-2 border-l-2 border-cyber-cyan"></div>
  <div aria-hidden="true" class="absolute bottom-0 right-0 w-4 h-4 border-b-2 border-r-2 border-cyber-cyan"></div>
</dialog>

<script>
  import '../scripts/share-dialog.js';
</script>
