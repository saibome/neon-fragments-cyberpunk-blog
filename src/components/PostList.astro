---
import { PAGE_SIZE } from '../consts';
import PostCard from './PostCard.astro';
import Icon from './Icon.astro';
import type { BlogPost } from '../types';

interface Props {
  posts: BlogPost[];
}

const { posts } = Astro.props;
---

<div data-post-list data-page-size={PAGE_SIZE} class="max-w-5xl mx-auto px-0 sm:px-6 lg:px-8 py-2 md:py-0">
  <div class="flex flex-col md:flex-row justify-between items-start mb-8 border-b-2 border-gray-800 pb-4 px-4 sm:px-0">
    <div>
      <h2 class="text-4xl font-display font-bold text-white mb-1">最新文章</h2>
      <p class="text-cyber-yellow font-mono text-xs">加密传输 // 已检测到公钥</p>
      <div data-tag-chip hidden class="mt-2 flex items-center space-x-2 bg-cyber-yellow/10 px-2 py-1 rounded border border-cyber-yellow/30 inline-flex">
        <span class="text-cyber-yellow font-mono text-xs">筛选：标签 [<span data-tag-label></span>]</span>
        <button type="button" data-clear-tag aria-label="清除标签筛选" class="text-cyber-yellow hover:text-white transition-colors">
          <Icon name="x" class="w-3 h-3" />
        </button>
      </div>
    </div>

    <div class="mt-4 md:mt-0 w-full md:w-auto">
      <div class="relative group">
        <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
          <Icon name="search" class="h-4 w-4 text-cyber-yellow group-focus-within:text-cyber-cyan transition-colors" />
        </div>
        <input
          type="text"
          data-post-search
          class="block w-full md:w-72 bg-black/80 border-2 border-cyber-yellow text-cyber-yellow placeholder-cyber-yellow/40 font-mono text-sm focus:outline-none focus:border-cyber-cyan focus:text-cyber-cyan focus:placeholder-cyber-cyan/40 py-3 pl-10 pr-10 clip-corner transition-all duration-300 uppercase tracking-wider"
          placeholder="搜索文章……"
          aria-label="搜索文章"
          autocomplete="off"
        />
        <button
          type="button"
          data-clear-search
          hidden
          aria-label="清空搜索"
          class="absolute inset-y-0 right-0 pr-3 flex items-center text-cyber-yellow hover:text-cyber-cyan transition-colors"
        >
          <Icon name="x" class="h-4 w-4" />
        </button>
        <div class="absolute top-0 right-0 w-2 h-2 bg-cyber-yellow group-focus-within:bg-cyber-cyan transition-colors"></div>
        <div class="absolute bottom-0 left-0 w-2 h-2 bg-cyber-yellow group-focus-within:bg-cyber-cyan transition-colors"></div>
      </div>
    </div>
  </div>

  <div class="grid grid-cols-1 gap-6">
    {posts.length === 0 ? (
      <div class="text-center text-gray-500 font-mono">暂无文章</div>
    ) : (
      posts.map(post => <PostCard post={post} />)
    )}
    <div data-empty hidden class="text-center text-gray-500 font-mono">没有匹配的数据碎片</div>
  </div>

  <div class="mt-12 flex justify-center items-center space-x-6">
    <button
      type="button"
      data-page-prev
      data-page-nav
      class="flex items-center space-x-2 font-mono text-sm uppercase tracking-widest border border-transparent px-4 py-2 transition-all text-cyber-cyan hover:border-cyber-cyan hover:bg-cyber-cyan/10"
    >
      <Icon name="chevron-left" class="w-4 h-4" />
      <span>上一页</span>
    </button>

    <div data-page-label class="font-mono text-cyber-yellow text-sm">第 <span class="text-white font-bold">1</span> 页，共 1 页</div>

    <button
      type="button"
      data-page-next
      data-page-nav
      class="flex items-center space-x-2 font-mono text-sm uppercase tracking-widest border border-transparent px-4 py-2 transition-all text-cyber-cyan hover:border-cyber-cyan hover:bg-cyber-cyan/10"
    >
      <span>下一页</span>
      <Icon name="chevron-right" class="w-4 h-4" />
    </button>
  </div>
</div>

<script>
  import '../scripts/post-list.js';
</script>
