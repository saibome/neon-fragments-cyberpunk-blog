---
import { DEFAULT_COVER } from '../consts';
import CyberDate from './CyberDate.astro';
import Icon from './Icon.astro';
import type { BlogPost } from '../types';

interface Props {
  post: BlogPost;
}

const { post } = Astro.props;
const displayImage = post.image || DEFAULT_COVER;
const summary = post.description || post.text || '暂无摘要';
---

<div
  data-post-card
  data-title={post.title.toLowerCase()}
  data-tags={post.tags.map(tag => tag.toLowerCase()).join('|')}
  class="block group relative bg-cyber-dark border-l-4 border-cyber-gray hover:border-cyber-yellow transition-all duration-300 p-6 mb-4 overflow-hidden hover:bg-gray-900"
>
  <div class="absolute inset-0 z-0">
    <div class="absolute inset-0 bg-cover bg-center opacity-20 group-hover:opacity-30 transition-opacity duration-300 mix-blend-overlay grayscale group-hover:grayscale-0" style={`background-image: url('${displayImage}')`}></div>
    <div class="absolute inset-0 bg-gradient-to-r from-cyber-dark via-cyber-dark/90 to-cyber-dark/80"></div>
  </div>
  <div class="absolute inset-0 bg-gradient-to-r from-cyber-yellow/0 to-cyber-yellow/0 group-hover:from-cyber-yellow/5 group-hover:to-transparent transition-all duration-500 pointer-events-none z-0"></div>

  <div class="relative z-10">
    <div class="flex justify-between items-start mb-2">
      <div class="flex items-center space-x-2 text-xs font-mono text-gray-500">
        <Icon name="clock" class="w-3 h-3" />
        <CyberDate date={post.date} />
        <span class="text-cyber-cyan uppercase"> // {post.author.name}</span>
      </div>
      {post.isGlitch && <Icon name="alert-triangle" class="w-4 h-4 text-cyber-red animate-pulse" />}
    </div>

    <h3 class="text-xl md:text-2xl font-display font-bold text-white group-hover:text-cyber-yellow mb-3 transition-colors uppercase tracking-tight">
      <a href={post.permalink} class="before:absolute before:inset-0 focus:outline-none">{post.title}</a>
    </h3>

    <p class="text-gray-400 line-clamp-2 font-sans mb-4 text-sm">{summary}</p>

    <div class="flex justify-between items-end">
      <div class="flex flex-wrap gap-2 relative z-20">
        {post.tags.map(tag => (
          <a href={`/?tag=${encodeURIComponent(tag)}`} class="flex items-center text-[10px] font-mono bg-gray-800 text-cyber-cyan px-2 py-1 border border-gray-700 hover:bg-gray-700 transition-colors">
            <Icon name="hash" class="w-2 h-2 mr-1" />
            {tag}
          </a>
        ))}
      </div>

      <a href={post.permalink} class="text-cyber-yellow opacity-0 group-hover:opacity-100 transition-all transform translate-x-[-10px] group-hover:translate-x-0 flex items-center text-sm font-bold uppercase font-mono relative z-20">
        阅读全文 <Icon name="chevron-right" class="w-4 h-4" />
      </a>
    </div>
  </div>
</div>
