---
import { NAV_ITEMS } from '../consts';
import GlitchText from './GlitchText.astro';
import Icon from './Icon.astro';

interface Props {
  activePath?: string;
}

const { activePath = '/' } = Astro.props;
---

<nav class="fixed top-0 z-50 w-full bg-cyber-black/90 backdrop-blur-sm border-b border-cyber-gray/50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative">
    <div class="flex items-center justify-between h-16">
      <div class="flex items-center">
        <button
          type="button"
          data-profile-toggle
          aria-label="切换个人资料"
          aria-expanded="false"
          class="md:hidden mr-4 text-cyber-yellow hover:text-cyber-cyan transition-colors z-50 relative"
        >
          <svg data-cyber-menu viewBox="0 0 24 24" fill="none" class="w-8 h-8" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <path class="menu-top" d="M2 6H22" stroke="currentColor" stroke-width="2" stroke-linecap="square" />
            <path class="menu-middle" d="M2 12H16" stroke="currentColor" stroke-width="2" stroke-linecap="square" />
            <path class="menu-middle" d="M19 12H22" stroke="currentColor" stroke-width="2" stroke-linecap="square" />
            <path class="menu-bottom" d="M2 18H22" stroke="currentColor" stroke-width="2" stroke-linecap="square" />
            <rect class="menu-decor" x="20" y="4" width="2" height="4" fill="currentColor" />
            <rect class="menu-decor" x="2" y="16" width="2" height="4" fill="currentColor" />
          </svg>
        </button>

        <a href="/" class="flex-shrink-0 cursor-pointer">
          <h1 class="text-3xl font-display font-bold italic tracking-tighter text-cyber-yellow">
            <span class="text-cyber-cyan mr-1">NC</span>SAIBO<span class="text-white">.</span>ME
          </h1>
        </a>
      </div>

      <div class="hidden md:block">
        <div class="ml-10 flex items-baseline space-x-8">
          {NAV_ITEMS.map(item => (
            <a
              href={item.path}
              class:list={[
                'group flex items-center px-3 py-2 text-sm font-medium font-mono transition-colors duration-200',
                item.path === activePath
                  ? 'text-cyber-yellow bg-cyber-gray/30 border-b-2 border-cyber-yellow'
                  : 'text-gray-400 hover:text-cyber-cyan'
              ]}
            >
              <Icon name={item.icon} class:list={['w-4 h-4 mr-2', item.path === activePath ? 'animate-pulse' : 'group-hover:text-cyber-red']} />
              <GlitchText text={item.label} />
            </a>
          ))}
        </div>
      </div>

      <div class="flex items-center">
        <div class="h-2 w-2 bg-green-500 rounded-full animate-ping mr-2"></div>
        <span class="text-xs font-mono text-green-500">在线</span>
      </div>
    </div>
  </div>
  <div class="h-[1px] w-full bg-gradient-to-r from-transparent via-cyber-cyan to-transparent opacity-50"></div>

  <div class="hidden lg:block absolute top-16 left-0 w-full h-0 pointer-events-none">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-full relative">
      <div class="absolute top-0 left-4 sm:left-6 lg:left-8 w-80 h-[calc(100vh-4rem)] overflow-y-auto pt-6 pb-6 pointer-events-auto no-scrollbar">
        <slot name="sidebar" />
      </div>
    </div>
  </div>
</nav>
