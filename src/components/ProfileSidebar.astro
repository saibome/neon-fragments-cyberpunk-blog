---
import { NAV_ITEMS } from '../consts';
import GlitchText from './GlitchText.astro';
import Icon from './Icon.astro';
import type { UserProfile } from '../types';

interface Props {
  user: UserProfile;
  activePath?: string;
}

const { user, activePath = '/' } = Astro.props;
---

<div class="bg-cyber-black border border-cyber-gray/50 p-6 clip-corner-tr relative overflow-hidden flex flex-col">
  <div class="absolute inset-0 bg-[linear-gradient(rgba(20,20,20,0.8)_1px,transparent_1px),linear-gradient(90deg,rgba(20,20,20,0.8)_1px,transparent_1px)] bg-[size:20px_20px] pointer-events-none z-0 opacity-50"></div>

  <div class="relative z-10">
    <div class="flex items-center space-x-4 mb-6">
      <div class="w-16 h-16 bg-cyber-yellow clip-both flex items-center justify-center overflow-hidden border-2 border-white">
        <img src="/avatar.svg" alt="头像" class="w-full h-full object-cover mix-blend-multiply grayscale contrast-125" />
      </div>
      <div>
        <h2 class="text-2xl font-display font-bold text-white leading-none">{user.name}</h2>
        {user.handle_link ? (
          <a href={user.handle_link} target="_blank" rel="noopener noreferrer" class="block text-cyber-yellow font-mono text-sm hover:underline hover:text-cyber-cyan transition-colors">{user.handle}</a>
        ) : (
          <span class="block text-cyber-yellow font-mono text-sm">{user.handle}</span>
        )}
        <div class="flex space-x-2 mt-1">
          <span class="inline-block bg-cyber-red text-black text-[10px] px-1 font-bold">等级 {user.level}</span>
          <span class="inline-block border border-cyber-cyan text-cyber-cyan text-[10px] px-1 font-bold uppercase">{user.role}</span>
        </div>
      </div>
    </div>

    <div class="mb-6">
      <p class="text-gray-400 text-sm font-mono leading-relaxed border-l-2 border-cyber-cyan pl-3 italic">"{user.bio}"</p>
    </div>

    <div class="space-y-4 font-mono text-xs">
      <div class="flex justify-between items-center">
        <span class="flex items-center text-gray-400 w-20"><Icon name="cpu" class="w-3 h-3 mr-2" /> RAM</span>
        <div class="w-32 h-2 bg-gray-800 rounded-none overflow-hidden"><div class="h-full bg-cyber-yellow" style={`width: ${user.stats.ram}%`}></div></div>
        <span class="text-cyber-yellow w-12 text-right">{user.stats.ram}%</span>
      </div>
      <div class="flex justify-between items-center">
        <span class="flex items-center text-gray-400 w-20"><Icon name="shield" class="w-3 h-3 mr-2" /> ICE</span>
        <div class="w-32 h-2 bg-gray-800 rounded-none overflow-hidden"><div class="h-full bg-cyber-red" style={`width: ${user.stats.cpu}%`}></div></div>
        <span class="text-cyber-red w-12 text-right">{user.stats.cpu}%</span>
      </div>
      <div class="flex justify-between items-center">
        <span class="flex items-center text-gray-400 w-20"><Icon name="wifi" class="w-3 h-3 mr-2" /> 上行链路</span>
        <div class="w-32 h-2 bg-gray-800 rounded-none overflow-hidden"><div class="h-full bg-cyber-cyan" style={`width: ${user.stats.network}%`}></div></div>
        <span class="text-cyber-cyan w-12 text-right">{user.stats.network}MS</span>
      </div>
    </div>

  </div>

  <div class="md:hidden mt-6 border-t border-cyber-gray/50 pt-4 relative z-10 -mx-6">
    <h3 class="text-cyber-cyan font-bold mb-4 text-sm uppercase tracking-widest px-6">导航</h3>
    <div class="flex flex-col">
      {NAV_ITEMS.map(item => (
        <a
          href={item.path}
          class:list={[
            'w-full group flex items-center px-6 py-3 text-sm font-medium font-mono transition-colors duration-200 border-l-2 border-transparent',
            item.path === activePath
              ? 'text-cyber-yellow bg-cyber-gray/30 border-l-cyber-yellow'
              : 'text-gray-400 hover:text-cyber-cyan hover:bg-cyber-gray/10 hover:border-l-cyber-cyan/30'
          ]}
        >
          <Icon name={item.icon} class:list={['w-4 h-4 mr-3', item.path === activePath ? 'animate-pulse' : 'group-hover:text-cyber-red']} />
          <GlitchText text={item.label} />
          {item.path === activePath && <span class="ml-auto w-2 h-2 bg-cyber-yellow rounded-full animate-ping"></span>}
        </a>
      ))}
    </div>
  </div>

  <div class="absolute top-0 right-0 p-2"><div class="w-2 h-2 bg-cyber-red"></div></div>
</div>
