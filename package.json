{
  "name": "neon-fragments-cyberpunk-blog",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=26",
    "pnpm": ">=12"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ShinChven/neon-fragments-cyberpunk-blog.git"
  },
  "scripts": {
    "dev": "vite",
    "build:content": "tsx scripts/build-content.ts",
    "build:client": "vite build --outDir dist/client && node scripts/move-template.mjs",
    "build:server": "vite build --ssr server/index.ts --outDir dist/server",
    "build": "pnpm build:content && pnpm build:client && pnpm build:server",
    "start": "node dist/server/index.js",
    "preview": "node dist/server/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint .",
    "test": "node --import tsx --test tests/permalink.test.ts tests/content.test.ts tests/posts.test.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.8",
    "@resvg/resvg-js": "^2.6.2",
    "d3": "^7.9.2",
    "gray-matter": "^4.0.3",
    "highlight.js": "^11.12.0",
    "hono": "^4.13.18",
    "lucide-react": "^1.72.0",
    "marked": "^18.2.0",
    "marked-highlight": "^2.2.4",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-helmet-async": "^2.0.5",
    "react-router": "^8.5.1",
    "satori": "^0.63.2"
  },
  "devDependencies": {
    "@hono/vite-dev-server": "^0.26.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/d3": "^7.4.3",
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sanitize-html": "^2.16.2",
    "@vitejs/plugin-react": "^6.3.0",
    "fast-glob": "^3.3.3",
    "oxlint": "^1.93.0",
    "sanitize-html": "^2.18.2",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "vite": "^8.3.8",
    "zod": "^4.6.7"
  }
}
