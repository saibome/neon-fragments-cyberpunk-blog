{
  "name": "neon-fragments-cyberpunk-blog",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "bun@1.4.4",
  "engines": {
    "node": ">=22.23.4",
    "bun": ">=1.4.4"
  },
  "trustedDependencies": [
    "esbuild"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/saibome/neon-fragments-cyberpunk-blog.git"
  },
  "scripts": {
    "dev": "bun run --bun astro dev --port 3000 --host 0.0.0.0",
    "publish": "bun scripts/publish-obsidian.mjs",
    "build": "bun run --bun astro build && bun scripts/postbuild.mjs",
    "build:edgeone": "bun run build && bun run check:edgeone",
    "check:edgeone": "bun scripts/check-edgeone.mjs",
    "typecheck": "bun run --bun astro check",
    "lint": "oxlint . --ignore-pattern=.astro",
    "test": "bun test tests"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.12",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.6",
    "astro": "^7.4.13",
    "oxlint": "^1.94.0",
    "qrcode": "^1.5.4",
    "satori": "^0.63.2",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "vite": "^8.3.8"
  }
}
