{
  "name": "neon-fragments-cyberpunk-blog",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=22.23.4",
    "pnpm": ">=12"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/saibome/neon-fragments-cyberpunk-blog.git"
  },
  "scripts": {
    "dev": "pnpm build:content && astro dev --port 3000 --host 0.0.0.0",
    "build:content": "tsx scripts/build-content.ts",
    "build": "pnpm build:content && astro build && node scripts/postbuild.mjs",
    "build:edgeone": "pnpm build && pnpm check:edgeone",
    "check:edgeone": "node scripts/check-edgeone.mjs",
    "start": "node scripts/serve.mjs",
    "preview": "node scripts/serve.mjs",
    "typecheck": "astro check",
    "lint": "oxlint . --ignore-pattern=.astro",
    "test": "node --import tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "gray-matter": "^4.0.3",
    "highlight.js": "^11.12.0",
    "marked": "^18.2.0",
    "marked-highlight": "^2.2.4",
    "qrcode": "^1.5.4",
    "satori": "^0.63.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.6",
    "@types/sanitize-html": "^2.16.2",
    "astro": "^7.4.12",
    "fast-glob": "^3.3.3",
    "oxlint": "^1.93.0",
    "sanitize-html": "^2.18.2",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "zod": "^4.6.7"
  }
}
