{
  "installCommand": "npm i -g bun@1.4.4 && bun install --frozen-lockfile",
  "buildCommand": "bun run build",
  "outputDirectory": "dist",
  "nodeVersion": "24.5.0",
  "headers": [
    {
      "source": "/_astro/*",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/fonts/*",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/*",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/net", "destination": "/net.html" },
    { "source": "/data", "destination": "/data.html" },
    { "source": "/gear", "destination": "/gear.html" }
  ],
  "cloudFunctions": {
    "maxDuration": 10
  }
}
